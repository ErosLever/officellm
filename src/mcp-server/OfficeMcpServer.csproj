<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Expose internals to the test project -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>mcp-server.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- RuntimeIdentifier is set only at publish time via -r flag, not here.
         Setting it here would force all builds (including test runs) into a
         platform-specific output subdirectory, breaking cross-platform development. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <AssemblyName>office-mcp-server</AssemblyName>
  </PropertyGroup>

  <!--
    ShapeCrawler is used for OOXML-level shape copying (preserves flipH/flipV,
    arrowhead styling, and other attributes Office.js can't read back).
    Its Magick.NET/SkiaSharp transitive deps are unused by the copy code paths
    we rely on, so they're pinned and excluded to avoid shipping ~650MB of
    native image-processing binaries. Re-verify on any ShapeCrawler upgrade.
  -->
  <ItemGroup>
    <PackageReference Include="ShapeCrawler" Version="0.80.0" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.16.0" ExcludeAssets="all" />
    <PackageReference Include="Magick.NET.Core" Version="14.16.0" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.151.1" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" ExcludeAssets="all" />
  </ItemGroup>

  <!--
    Pre-build: if GeneratedToken.cs is missing, run generate-token.mjs.
    Requires Node.js on PATH. On CI, run the script explicitly before dotnet build.
  -->
  <Target Name="EnsureTokenGenerated" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <GeneratedTokenPath>$(MSBuildProjectDirectory)/GeneratedToken.cs</GeneratedTokenPath>
      <TokenScriptPath>$(MSBuildProjectDirectory)/../../scripts/generate-token.mjs</TokenScriptPath>
    </PropertyGroup>
    <Message Text="Checking for GeneratedToken.cs..." Importance="normal" />
    <Exec
      Condition="!Exists('$(GeneratedTokenPath)')"
      Command="node &quot;$(TokenScriptPath)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
    />
    <Error
      Condition="!Exists('$(GeneratedTokenPath)')"
      Text="GeneratedToken.cs still missing after running generate-token.mjs. Ensure Node.js is on PATH." />
  </Target>

</Project>
